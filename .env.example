# ─── Application ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Origines supplémentaires (ngrok…), séparées par des virgules
BETTER_AUTH_TRUSTED_ORIGINS=

# ─── Base de données PostgreSQL ────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agendo
# Connexion directe pour les migrations (Supabase/Neon) — facultatif
DIRECT_URL=

# ─── Google OAuth + Calendar API ───────────────────────────
# console.cloud.google.com → API "Google Calendar API" activée
# Identifiants OAuth "Application Web", URI de redirection :
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── E-mails (resend.com) ──────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Agendo <rdv@votre-domaine.com>"

# ─── SMS & WhatsApp (twilio.com) ───────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numéro SMS Twilio au format E.164
TWILIO_SMS_FROM=
# Sandbox : whatsapp:+14155238886 — en production, numéro WhatsApp Business validé
TWILIO_WHATSAPP_FROM=

# ─── Cron des rappels ──────────────────────────────────────
# openssl rand -hex 32 — Vercel l'envoie automatiquement en Authorization: Bearer
CRON_SECRET=
